# Database Configuration (Defaults to local SQLite fallback if SUPABASE_URL is empty)
DATABASE_URL=sqlite+aiosqlite:///./crexi_realestate.db
SUPABASE_URL=
SUPABASE_KEY=

# Proxy & Scraping Config
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_MS=30000
ROTATING_PROXY_URL=

# ML & Feature Store Config
ANOMALY_THRESHOLD=2.5
VALUATION_MODEL_PATH=./app/ml/saved_models/valuation_model.joblib

# Application Config
APP_NAME="PropYield AI - Enterprise Commercial Real Estate Engine"
API_V1_STR=/api/v1
DEBUG=true
